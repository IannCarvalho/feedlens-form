{
  "name": "feedlens-feedback-form",
  "version": "0.1.0",
  "description": "Formulário público do FeedLens (Angular 22): o cliente final só envia feedback.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "config:gen": "node scripts/gen-config.mjs",
    "prebuild": "node scripts/gen-config.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit",
    "test": "ng test --no-watch",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "ng lint"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  }
}
